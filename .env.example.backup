# Application Configuration
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (shared across all services)
# For local development, use a local PostgreSQL or Neon Serverless
DATABASE_URL=postgresql://user:password@localhost:5432/evalops
# Or use Neon Serverless:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/evalops?sslmode=require

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# CORS Configuration (API Gateway)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Service URLs (for inter-service communication)
AUTH_SERVICE_URL=http://localhost:3001
CORE_SERVICE_URL=http://localhost:3002
EVALUATION_SERVICE_URL=http://localhost:3003
INTEGRATION_SERVICE_URL=http://localhost:3004
ANALYTICS_SERVICE_URL=http://localhost:3005

# Redis Configuration (for BullMQ message queues)
# Install Redis locally or use a cloud Redis service
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AI Provider API Keys (at least one required for evaluation)
# Azure OpenAI (recommended)
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-ada-002

# Or use OpenAI directly
OPENAI_API_KEY=sk-...

# Optional: Other AI providers
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
XAI_API_KEY=...

# Optional: Microsoft Entra ID SSO
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# Python Worker (optional, for advanced evaluations)
PYTHON_WORKER_URL=http://localhost:5055

# Azure ML (optional, for Prompt Flow integration)
AZURE_ML_ENDPOINT=https://your-workspace.api.azureml.ms
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_ML_API_KEY=your-ml-api-key
