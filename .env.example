# Application Configuration
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# Database Configuration (shared across all services)
# For local development with Tilt.dev (recommended):
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/evalops
# For local development without Tilt, use localhost:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evalops
# Or use Neon Serverless:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/evalops?sslmode=require

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# Service-to-service authentication token (required)
# Generate with: openssl rand -hex 32
SERVICE_SECRET=your-service-secret-change-in-production-min-32-chars

# CORS Configuration (API Gateway)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Service URLs (for inter-service communication)
AUTH_SERVICE_URL=http://localhost:3001
CORE_SERVICE_URL=http://localhost:3002
EVALUATION_SERVICE_URL=http://localhost:3003
INTEGRATION_SERVICE_URL=http://localhost:3004
ANALYTICS_SERVICE_URL=http://localhost:3005

# Redis Configuration (for BullMQ message queues)
# For local development with Tilt.dev (recommended):
REDIS_HOST=localhost
REDIS_PORT=16379
# For local development without Tilt, use:
# REDIS_HOST=localhost
# REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AI Provider API Keys (at least one required for evaluation)
# Azure OpenAI (recommended)
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-ada-002

# Or use OpenAI directly
OPENAI_API_KEY=sk-...

# Optional: Other AI providers
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
XAI_API_KEY=...

# Optional: Microsoft Entra ID SSO
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# Python Worker (optional, for advanced evaluations)
PYTHON_WORKER_URL=http://localhost:5055

# OpenSandbox Configuration (for secure code execution)
# OpenSandbox server URL (default: http://localhost:8080)
OPENSANDBOX_SERVER_URL=http://localhost:8080
# API key for OpenSandbox authentication (matches ~/.sandbox.toml)
OPENSANDBOX_API_KEY=your-opensandbox-api-key
# Default resource limits (optional, can use server defaults)
OPENSANDBOX_DEFAULT_CPU=1.0
OPENSANDBOX_DEFAULT_MEMORY=512Mi
OPENSANDBOX_DEFAULT_TIMEOUT=300
OPENSANDBOX_MAX_CONCURRENT=10

# Sandbox Security Configuration
# Network egress policy: deny_all, allow_all, or restricted
OPENSANDBOX_NETWORK_POLICY=restricted
# Comma-separated list of allowed domains (FQDN) for restricted policy
OPENSANDBOX_ALLOWED_DOMAINS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com
# Comma-separated list of blocked domains
OPENSANDBOX_BLOCKED_DOMAINS=localhost,127.0.0.1,internal.evalops.local
# Maximum resource limits
OPENSANDBOX_MAX_CPU=2.0
OPENSANDBOX_MAX_MEMORY=2Gi
OPENSANDBOX_MAX_TIMEOUT=600
# Enable AST-based code validation (requires @typescript-eslint/parser)
OPENSANDBOX_REQUIRE_AST_VALIDATION=true

# Sandbox Monitoring
# Enable monitoring and metrics tracking
OPENSANDBOX_ENABLE_MONITORING=true
# Enable anomaly detection
OPENSANDBOX_ANOMALY_DETECTION=true
# Resource alert threshold (0-1, alerts when usage exceeds this percentage)
OPENSANDBOX_RESOURCE_ALERT_THRESHOLD=0.8

# Azure ML (optional, for Prompt Flow integration)
AZURE_ML_ENDPOINT=https://your-workspace.api.azureml.ms
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_ML_API_KEY=your-ml-api-key
