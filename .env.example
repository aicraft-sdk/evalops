# Required: database connection
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/evalops

# Required: authentication secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
SERVICE_SECRET=your-service-secret-change-in-production-min-32-chars

# Required: at least one AI provider key for LLM evaluations
OPENAI_API_KEY=sk-...

# See .env.optional.example for Redis, Azure ML, Entra SSO, OpenSandbox, and other settings
