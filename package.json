{
  "name": "evalops",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many --target=serve --projects=frontend,api-gateway,auth-service,core-service,evaluation-service --parallel",
    "dev:frontend": "nx serve frontend",
    "dev:gateway": "nx serve api-gateway",
    "dev:auth": "nx serve auth-service",
    "dev:core": "nx serve core-service",
    "dev:evaluation": "nx serve evaluation-service",
    "build": "nx run-many --target=build --projects=frontend,api-gateway,auth-service,core-service,evaluation-service",
    "build:frontend": "nx build frontend",
    "build:gateway": "nx build api-gateway",
    "build:auth": "nx build auth-service",
    "build:core": "nx build core-service",
    "build:evaluation": "nx build evaluation-service",
    "start": "nx serve api-gateway",
    "start:frontend": "nx serve frontend",
    "start:gateway": "nx serve api-gateway",
    "check": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "test:unit": "nx run-many --target=test --all --testPathPattern=spec",
    "test:e2e": "nx run-many --target=test --all --testPathPattern=e2e",
    "db:push": "drizzle-kit push --config=libs/shared-db/drizzle.config.ts",
    "tilt:up": "tilt up",
    "tilt:down": "tilt down",
    "setup": "bash scripts/setup.sh",
    "setup:check": "bash scripts/setup-check.sh",
    "setup:secrets": "bash scripts/generate-secrets.sh",
    "quick-start": "bash scripts/quick-start.sh",
    "evalops": "node_modules/.bin/tsx apps/cli/src/main.ts",
    "local-lint": "npx @bcai/ai-resources-cli tools linter/agents-md-lint",
    "self-eval": "npm run evalops -- eval run \"EvalOps Self-Evals\" --watch"
  },
