{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/libs/shared-common",
    "rootDir": "src",
    "declaration": true,
    "composite": true,
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {}
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
