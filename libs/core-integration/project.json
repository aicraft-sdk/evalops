{
  "name": "core-integration",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/core-integration/src",
  "projectType": "library",
  "tags": ["scope:core-integration", "type:lib"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/core-integration",
        "main": "libs/core-integration/src/index.ts",
        "tsConfig": "libs/core-integration/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/core-integration/jest.config.cts"
      }
    }
  }
}
