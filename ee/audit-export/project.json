{
  "name": "ee-audit-export",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "ee/audit-export/src",
  "projectType": "library",
  "tags": ["scope:enterprise", "type:lib", "domain:audit"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/ee/audit-export",
        "main": "ee/audit-export/src/index.ts",
        "tsConfig": "ee/audit-export/tsconfig.lib.json",
        "assets": ["ee/audit-export/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": { "jestConfig": "ee/audit-export/jest.config.cts" }
    }
  }
}
